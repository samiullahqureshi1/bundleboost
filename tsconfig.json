{
  "include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
  // Customer account extensions use Preact and their own Polaris types; each
  // has its own tsconfig (npm run typecheck:extensions).
  "exclude": ["node_modules", "build", "extensions/bundleboost-subscriptions-portal", "extensions/bundleboost-subscription-links"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "types": ["node", "@react-router/node", "vite/client", "@shopify/polaris-types", "@shopify/app-bridge-types"],
    "rootDirs": [".", "./.react-router/types"]
  }
}
