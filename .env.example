# BundleBoost environment variables. Copy to .env for local development.
# `shopify app dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES automatically; set them yourself in production.

# PostgreSQL (Neon). DATABASE_URL = pooled connection ("-pooler" host) used by
# the app; DIRECT_URL = direct connection used by Prisma Migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional: set to "neon" to connect over WebSockets (port 443) on networks
# that block Postgres port 5432. Leave unset in production.
DATABASE_ADAPTER=

# Required in production (never commit real values).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_discounts

# --- Billing (Shopify App Pricing) — see docs/BILLING.md ---
# App handle (the {app_handle} in admin.shopify.com/store/{store}/charges/{app_handle}/pricing_plans).
SHOPIFY_APP_HANDLE=
# Partner organization ID (number in your Partner Dashboard URL).
SHOPIFY_PARTNER_ORG_ID=
# Partner API client access token (Partner Dashboard > Settings > Partner API clients). Secret.
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
# App GID: gid://shopify/App/{numeric app id}
SHOPIFY_APP_GID=

# Optional: custom shop domain for development stores on custom domains.
SHOP_CUSTOM_DOMAIN=
